# Puerto de la API
PORT=3000

# Cadena de conexión de Supabase: Project Settings → Database → Connection string
# (modo "Session pooler" si tu red no tiene IPv6). Reemplazá [YOUR-PASSWORD].
# Para desarrollo local: postgres://postgres:postgres@localhost:5432/barrio_watch
DATABASE_URL=postgresql://postgres.xxxxxxxx:[YOUR-PASSWORD]@aws-0-sa-east-1.pooler.supabase.com:5432/postgres
# true para Supabase. Opcional: ruta al certificado CA de Supabase para verificarlo.
DATABASE_SSL=true
# DATABASE_CA_CERT=./prod-ca-2021.crt

# Secreto para firmar los tokens de sesión. Generá uno con:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=cambiame-por-un-secreto-largo-y-aleatorio

# URL del frontend: se usa para CORS y para armar el enlace de recuperación
FRONTEND_URL=http://localhost:5173

# Si la API corre detrás de un proxy (Render, Railway…) poné 1 para registrar la IP real
# TRUST_PROXY=1

# Correo saliente (HU05). Si SMTP_HOST queda vacío, el enlace se imprime en la consola.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Barrio Watch <no-responder@barriowatch.com>"
